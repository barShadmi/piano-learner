{
  "name": "audio-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Piano Learner native audio engine (Rust, napi-rs)",
  "main": "audio-engine.node",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "audio-engine",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --output-dir . --no-js",
    "build:debug": "napi build --platform --output-dir . --no-js"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.11.1"
  }
}
